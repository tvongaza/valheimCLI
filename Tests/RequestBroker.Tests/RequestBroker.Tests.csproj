<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain .NET files (no Unity) compiled here from the mod and CLI sources. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The CLI client files are written against implicit usings, as the CLI project is. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>valheimCLI.Tests</RootNamespace>
    <!-- CallFixtures has a pointer-parameter method, which cli_call must refuse. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

