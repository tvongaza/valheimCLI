<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The broker is plain .NET (no Unity, no sockets): compiled here from the mod source. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>valheimCLI.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Source/RequestBroker.cs" Link="Source/RequestBroker.cs" />
    <Compile Include="../../Source/OperationGate.cs" Link="Source/OperationGate.cs" />
    <Compile Include="../../Source/CliCommandValidity.cs" Link="Source/CliCommandValidity.cs" />
    <Compile Include="../../Source/TerrainEditRequest.cs" Link="Source/TerrainEditRequest.cs" />
    <Compile Include="../../Source/SessionArguments.cs" Link="Source/SessionArguments.cs" />
    <Compile Include="../../Source/CaptureCommands.cs" Link="Source/CaptureCommands.cs" />
    <Compile Include="../../Source/CommandArguments.cs" Link="Source/CommandArguments.cs" />
    <Compile Include="../../CLI/Testing/CommandInfo.cs" Link="CLI/CommandInfo.cs" />
    <Compile Include="../../CLI/Testing/CommandMetadata.cs" Link="CLI/CommandMetadata.cs" />
    <Compile Include="../../CLI/Testing/CliModels.cs" Link="CLI/CliModels.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

</Project>
