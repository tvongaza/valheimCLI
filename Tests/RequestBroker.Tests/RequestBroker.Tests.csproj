<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The broker is plain .NET (no Unity, no sockets): compiled here from the mod source. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>valheimCLI.Tests</RootNamespace>
    <!-- CallFixtures has a pointer-parameter method, which cli_call must refuse. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Source/RequestBroker.cs" Link="Source/RequestBroker.cs" />
    <Compile Include="../../Source/OperationGate.cs" Link="Source/OperationGate.cs" />
    <Compile Include="../../Source/StaticMemberCall.cs" Link="Source/StaticMemberCall.cs" />
    <Compile Include="../../Source/CallValues.cs" Link="Source/CallValues.cs" />
    <Compile Include="../../CLI/Testing/CliModels.cs" Link="CLI/CliModels.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

</Project>
